"use server";

import { prisma } from "@/lib/prisma";

function normalizeStatus(status?: string | null) {
  return (status ?? "").toUpperCase();
}

function buildStudentInsight(student: any) {
  const fees = student.fees ?? [];
  const attendance = student.attendance ?? [];

  const totalFee = fees.reduce(
    (sum: number, fee: any) => sum + Number(fee.totalFee ?? 0),
    0
  );

  const paidAmount = fees.reduce(
    (sum: number, fee: any) => sum + Number(fee.paidAmount ?? 0),
    0
  );

  const balance = Math.max(totalFee - paidAmount, 0);
  const latestFee = fees[0];

  const present = attendance.filter((entry: any) =>
    ["P", "PRESENT", "Present"].includes(normalizeStatus(entry.status))
  ).length;

  const absent = attendance.filter((entry: any) =>
    ["A", "ABSENT", "Absent"].includes(normalizeStatus(entry.status))
  ).length;

  const late = attendance.filter((entry: any) =>
    ["L", "LATE", "Late"].includes(normalizeStatus(entry.status))
  ).length;

  return {
    ...student,
    feeSummary: {
      totalFee,
      paidAmount,
      balance,
      status: latestFee?.status ?? "Pending",
    },
    attendanceSummary: {
      present,
      absent,
      late,
      total: attendance.length,
    },
  };
}

export async function globalSearch(query: string) {
  if (!query.trim()) {
    return {
      students: [],
      notes: [],
      fees: [],
    };
  }

  const value = query.trim();

  const students = await prisma.student.findMany({
    where: {
      OR: [
        {
          name: {
            contains: value,
            mode: "insensitive",
          },
        },
        {
          fatherName: {
            contains: value,
            mode: "insensitive",
          },
        },
        {
          admissionNo: {
            contains: value,
            mode: "insensitive",
          },
        },
        {
          rollNumber: {
            contains: value,
            mode: "insensitive",
          },
        },
      ],
    },
    include: {
      fees: true,
      attendance: true,
    },
    take: 5,
  });

  const notes = await prisma.note.findMany({
    where: {
      OR: [
        {
          title: {
            contains: value,
            mode: "insensitive",
          },
        },
        {
          subject: {
            contains: value,
            mode: "insensitive",
          },
        },
      ],
    },
    take: 5,
  });

  const fees = await prisma.fee.findMany({
    where: {
      student: {
        OR: [
          {
            name: {
              contains: value,
              mode: "insensitive",
            },
          },
          {
            rollNumber: {
              contains: value,
              mode: "insensitive",
            },
          },
        ],
      },
    },
    include: {
      student: true,
    },
    take: 5,
  });

  return {
    students: students.map(buildStudentInsight),
    notes,
    fees,
  };
}
