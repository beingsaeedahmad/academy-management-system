generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Student {
  id String @id @default(cuid())

  admissionNo String @unique
  rollNumber String @unique

  name String
  fatherName String
  gender String?

  className String

  phone String
  email String?
  address String?

  monthlyFees Int

  photo String?

  admissionDate DateTime

  status String @default("Active") // <-- Add this

  fees Fee[]
  attendance Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  results Result[]
}

model Fee {
  id String @id @default(cuid())

  studentId String
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  month Int
  year Int

  totalFee Int

  paidAmount Int @default(0)

  dueDate DateTime

  paymentDate DateTime?

  remarks String?

  status String @default("Pending")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([studentId, month, year])
}

model Attendance {
  id String @id @default(cuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  date DateTime

  status String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, date])
}
model Subject {
  id String @id @default(cuid())

  name String
  code String @unique

  chapter String
  className String
  teacherName String?

  fileName String
  fileType String
  fileSize Int
  fileUrl String

  status String @default("Active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Note {
  id String @id @default(cuid())

  title String
  description String?

  fileName String
  fileType String
  fileSize Int

  fileUrl String?

  subject String?
  className String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Result {
  id           String   @id @default(cuid())
  studentId    String
  subjectId    String?
  examName     String
  totalMarks   Float
  obtainedMarks Float
  grade        String?
  remarks      String?
  examDate     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([subjectId])
  @@index([examName])
}